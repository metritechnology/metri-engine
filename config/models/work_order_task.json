{
  "entity": "work_order_task",
  "engine": "oltp",
  "is_system": false,
  "track_history": true,
  "attributes": [
    {
      "name": "work_order_id",
      "type": "reference",
      "entityRef": "work_order",
      "cardinality": "one",
      "required": true,
      "is_dimension": true
    },
    {
      "name": "task_template_id",
      "type": "reference",
      "entityRef": "task_template",
      "cardinality": "one",
      "description": "Si est\u00e1 presente, esta tarea fue generada basada en un protocolo o plantilla estandarizada",
      "is_dimension": true
    },
    {
      "name": "description",
      "type": "string",
      "required": true,
      "fts": true
    },
    {
      "name": "assigned_user_id",
      "type": "reference",
      "entityRef": "user",
      "cardinality": "one",
      "is_dimension": true
    },
    {
      "name": "assigned_group_id",
      "type": "reference",
      "entityRef": "user_group",
      "cardinality": "one",
      "is_dimension": true
    },
    {
      "name": "estimated_duration_minutes",
      "type": "decimal",
      "description": "Tiempo estimado en MINUTOS para c\u00e1lculos OLAP precisos",
      "is_measure": true,
      "default_rollup": "sum"
    },
    {
      "name": "note_ids",
      "type": "reference",
      "entityRef": "note",
      "cardinality": "many",
      "description": "Logs of auditable notes containing timestamps and the author user"
    },
    {
      "name": "status",
      "type": "enum",
      "options": [
        "PENDING",
        "IN_PROGRESS",
        "COMPLETED",
        "SKIPPED"
      ],
      "default_value": "PENDING",
      "is_dimension": true
    },
    {
      "name": "evidence_file_ids",
      "type": "reference",
      "entityRef": "file",
      "cardinality": "many",
      "description": "Photos, resources, or files attached to this specific task as evidence"
    },
    {
      "name": "completed_by",
      "type": "reference",
      "entityRef": "user",
      "cardinality": "one"
    },
    {
      "name": "completed_at",
      "type": "epoch",
      "index": true
    }
  ]
}
