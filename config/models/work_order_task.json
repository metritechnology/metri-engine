{
  "entity": "work_order_task",
  "engine": "oltp",
  "is_system": false,
  "track_history": false,
  "attributes": [
    {
      "name": "work_order_id",
      "type": "reference",
      "entityRef": "work_order",
      "cardinality": "one",
      "required": true,
      "index": true,
      "description": "Orden dueña de la tarea."
    },
    {
      "name": "task_template_id",
      "type": "reference",
      "entityRef": "task_template",
      "cardinality": "one",
      "index": true,
      "description": "Plantilla que la engendró (provenance)."
    },
    {
      "name": "description",
      "type": "string",
      "fts": true,
      "description": "Enunciado de la tarea."
    },
    {
      "name": "status",
      "type": "enum",
      "options": ["PENDING", "IN_PROGRESS", "COMPLETED", "SKIPPED"],
      "default_value": "PENDING",
      "is_dimension": true,
      "description": "Ciclo de vida de la tarea dentro de la orden."
    },
    {
      "name": "asset_id",
      "type": "reference",
      "entityRef": "asset",
      "cardinality": "one",
      "description": "Sujeto concreto de la tarea."
    },
    {
      "name": "location_id",
      "type": "reference",
      "entityRef": "location",
      "cardinality": "one",
      "description": "Ubicación de la tarea."
    },
    {
      "name": "assigned_user_id",
      "type": "reference",
      "entityRef": "user",
      "cardinality": "one",
      "description": "Técnico asignado."
    },
    {
      "name": "assigned_group_id",
      "type": "reference",
      "entityRef": "user_group",
      "cardinality": "one",
      "description": "Cuadrilla asignada."
    },
    {
      "name": "scheduled_start",
      "type": "epoch",
      "description": "Inicio de la ventana secuencial que compone el compositor."
    },
    {
      "name": "scheduled_end",
      "type": "epoch",
      "description": "Fin de la ventana secuencial."
    },
    {
      "name": "estimated_duration_minutes",
      "type": "number",
      "description": "Duración estimada copiada de la plantilla."
    },
    {
      "name": "completed_by",
      "type": "reference",
      "entityRef": "user",
      "cardinality": "one",
      "description": "Quien cerró la tarea."
    },
    {
      "name": "completed_at",
      "type": "epoch",
      "description": "Cuándo se cerró la tarea."
    }
  ]
}
