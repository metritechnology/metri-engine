{
  "entity": "form_template",
  "engine": "oltp",
  "is_system": false,
  "track_history": true,
  "attributes": [
    {
      "name": "name",
      "type": "string",
      "required": true,
      "fts": true,
      "is_dimension": true
    },
    {
      "name": "description",
      "type": "string",
      "fts": true
    },
    {
      "name": "version",
      "type": "decimal",
      "default_value": 1.0,
      "description": "Template version for audit trails."
    },
    {
      "name": "status",
      "type": "enum",
      "options": [
        "DRAFT",
        "PUBLISHED",
        "RETIRED"
      ],
      "default_value": "PUBLISHED",
      "is_dimension": true,
      "description": "Ciclo de vida en paridad con procedure: solo las PUBLISHED se ofrecen para instanciar checklists y requests; DRAFT se edita sin ofrecerse; RETIRED conserva el histórico. Default PUBLISHED: toda plantilla existente sigue usable."
    }
  ]
}
