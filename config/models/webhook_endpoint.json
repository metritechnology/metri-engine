{
  "entity": "webhook_endpoint",
  "is_system": true,
  "track_history": true,
  "attributes": [
    {
      "name": "name",
      "type": "string",
      "required": true,
      "fts": true,
      "fuzzy_profile": {
        "max_edit_distance": 2,
        "enable_symspell": true,
        "enable_trigrams": true,
        "phonetic_algorithm": "romance_phonetic",
        "alphanumeric_code_normalizer": true,
        "bm25_field_boost": 3.5,
        "synonym_dictionary_uri": "urn:api:system:cmms_synonyms"
      }
    },
    {
      "name": "target_url",
      "type": "string",
      "required": true,
      "pattern": "^https://([a-zA-Z0-9-]+\\.)+[a-zA-Z]{2,}(:[0-9]{1,5})?(/.*)?$"
    },
    {
      "name": "http_method",
      "type": "enum",
      "options": [
        "POST",
        "PUT",
        "PATCH"
      ],
      "default_value": "POST"
    },
    {
      "name": "authentication_type",
      "type": "enum",
      "options": [
        "NONE",
        "BEARER_TOKEN",
        "BASIC_AUTH",
        "CUSTOM_HEADER"
      ],
      "default_value": "NONE"
    },
    {
      "name": "auth_token",
      "type": "string",
      "crypto_envelope": true,
      "description": "Token de autenticación del destino. Interceptado por Envelope Encryption en el Gateway (KMS) para asentar solo el Ciphertext en la DB."
    },
    {
      "name": "subscribed_rule_ids",
      "type": "reference",
      "entityRef": "event_routing_rule",
      "cardinality": "many",
      "required": true,
      "description": "Lista de las Event Routing Rules (Triggers) que ejecutarán este Webhook."
    },
    {
      "name": "max_retries",
      "type": "long",
      "default_value": 3
    },
    {
      "name": "is_active",
      "type": "boolean",
      "default_value": true
    }
  ]
}
