{
  "entity": "location",
  "engine": "oltp",
  "is_system": false,
  "track_history": true,
  "is_sequence_scope_provider": true,
  "doc_scope": "Cuando is_sequence_scope_provider=true, el tag de esta entidad puede usarse como scope de contadores secuenciales en otras entidades (ej: work_order_number por location). El OLTPChannel detecta autom\u00e1ticamente los campos entityRef que apuntan a esta entidad y tienen is_sequence_scope=true.",
  "attributes": [
    {
      "name": "name",
      "type": "string",
      "fts": true,
      "required": true
    },
    {
      "name": "tag",
      "type": "string",
      "unique": "identity",
      "pattern": "^L-[A-Z0-9]{6}$",
      "fts": true,
      "auto_generate": {
        "strategy": "stochastic_base36",
        "prefix": "L-",
        "length": 6
      }
    },
    {
      "name": "type",
      "type": "enum",
      "options": [
        "SITE",
        "BUILDING",
        "FLOOR",
        "ROOM",
        "ZONE"
      ],
      "required": true,
      "is_dimension": true
    },
    {
      "name": "parent_location_id",
      "type": "reference",
      "entityRef": "location",
      "cardinality": "one",
      "is_dimension": true
    },
    {
      "name": "coordinates_geojson",
      "type": "string"
    },
    {
      "name": "area_value",
      "type": "double",
      "is_measure": true,
      "default_rollup": "avg"
    },
    {
      "name": "area_unit",
      "type": "enum",
      "options": [
        "m2",
        "ft2",
        "sq_yd"
      ],
      "default_value": "m2",
      "is_dimension": true
    }
  ],
  "event_rules": [
    {
      "rule_code": "LOCATION_CREATED",
      "event_trigger_type": "on_create",
      "filter_conditions": [],
      "detail_type_output": "system.location.created",
      "description": "Notificaci\u00f3n sist\u00e9mica global al crear una nueva ubicaci\u00f3n."
    }
  ]
}
