{
  "entity": "labor_log",
  "engine": "oltp",
  "is_system": false,
  "track_history": true,
  "partition_strategy": "YYYY-MM-DD",
  "attributes": [
    {
      "name": "work_order_id",
      "type": "reference",
      "entityRef": "work_order",
      "cardinality": "one",
      "required": true,
      "is_dimension": true
    },
    {
      "name": "user_id",
      "type": "reference",
      "entityRef": "user",
      "cardinality": "one",
      "required": true,
      "is_dimension": true
    },
    {
      "name": "start_time",
      "type": "epoch",
      "required": true,
      "index": true
    },
    {
      "name": "end_time",
      "type": "epoch",
      "index": true
    },
    {
      "name": "duration_minutes",
      "type": "decimal",
      "is_measure": true,
      "default_rollup": "sum"
    },
    {
      "name": "hourly_rate",
      "type": "decimal",
      "description": "Rate at the time the labor was logged"
    },
    {
      "name": "task_description",
      "type": "string",
      "fts": true
    }
  ]
}
