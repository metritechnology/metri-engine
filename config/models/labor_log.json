{
  "entity": "labor_log",
  "engine": "oltp",
  "is_system": false,
  "track_history": true,
  "partition_strategy": "YYYY-MM-DD",
  "attributes": [
    {
      "name": "work_order_id",
      "type": "reference",
      "entityRef": "work_order",
      "cardinality": "one",
      "required": true,
      "is_dimension": true
    },
    {
      "name": "user_id",
      "type": "reference",
      "entityRef": "user",
      "cardinality": "one",
      "required": true,
      "is_dimension": true
    },
    {
      "name": "start_time",
      "type": "epoch",
      "required": true,
      "index": true
    },
    {
      "name": "end_time",
      "type": "epoch",
      "index": true
    },
    {
      "name": "duration_minutes",
      "type": "decimal",
      "is_measure": true,
      "default_rollup": "sum"
    },
    {
      "name": "task_description",
      "type": "string",
      "fts": true
    },
    {
      "name": "hourly_rate_cents",
      "type": "number",
      "is_measure": true,
      "default_rollup": "sum",
      "description": "Tarifa horaria al momento del registro, en la unidad menor de la divisa (céntimos)."
    },
    {
      "name": "currency",
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "is_dimension": true,
      "default_value": "USD",
      "description": "Divisa ISO 4217 de la tarifa. Por defecto hereda la del tenant."
    }
  ]
}
