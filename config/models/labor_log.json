{
  "entity": "labor_log",
  "is_system": false,
  "track_history": true,
  "attributes": [
    {
      "name": "work_order_id",
      "type": "reference",
      "entityRef": "work_order",
      "cardinality": "one",
      "required": true,
      "is_dimension": true
    },
    {
      "name": "user_id",
      "type": "reference",
      "entityRef": "user",
      "cardinality": "one",
      "required": true,
      "is_dimension": true
    },
    {
      "name": "start_time",
      "type": "epoch",
      "required": true,
      "index": true
    },
    {
      "name": "end_time",
      "type": "epoch",
      "index": true
    },
    {
      "name": "duration_minutes",
      "type": "decimal",
      "is_measure": true,
      "default_rollup": "sum",
      "math_profile": {
        "synopsis_tier": "hyper_512b",
        "distribution_family": "lognormal",
        "outlier_sigma_threshold": 3.5,
        "ema_alphas": [
          0.05,
          0.2,
          0.5
        ],
        "enable_cusum": true,
        "cusum_slack_k": 0.5,
        "cusum_threshold_h": 4.0,
        "enable_benford_audit": false,
        "enable_weibull_mle": true
      }
    },
    {
      "name": "hourly_rate_cents",
      "type": "number",
      "is_measure": true,
      "default_rollup": "sum",
      "description": "Tarifa horaria al momento del registro, en la unidad menor de la divisa (céntimos).",
      "math_profile": {
        "synopsis_tier": "hyper_512b",
        "distribution_family": "pareto",
        "outlier_sigma_threshold": 4.0,
        "ema_alphas": [
          0.05,
          0.2,
          0.5
        ],
        "enable_cusum": false,
        "cusum_slack_k": 0.5,
        "cusum_threshold_h": 4.0,
        "enable_benford_audit": true,
        "enable_weibull_mle": false
      }
    },
    {
      "name": "start_latitude",
      "type": "decimal",
      "description": "Latitud GPS registrada por el dispositivo móvil al iniciar la labor."
    },
    {
      "name": "start_longitude",
      "type": "decimal",
      "description": "Longitud GPS registrada por el dispositivo móvil al iniciar la labor."
    },
    {
      "name": "end_latitude",
      "type": "decimal",
      "description": "Latitud GPS registrada por el dispositivo móvil al finalizar la labor."
    },
    {
      "name": "end_longitude",
      "type": "decimal",
      "description": "Longitud GPS registrada por el dispositivo móvil al finalizar la labor."
    },
    {
      "name": "is_geofence_verified",
      "type": "boolean",
      "default_value": "false",
      "is_dimension": true,
      "description": "Marca de auditoría que confirma si el registro se hizo dentro del radio de ubicación permitido del activo o la ubicación asignada."
    }
  ],
  "constraints": [
    {
      "type": "at_least",
      "field": "end_time",
      "of": "start_time",
      "description": "Un fichaje no puede terminar antes de empezar: end_time nunca anterior a start_time."
    }
  ],
  "spatial_profile": {
    "enabled": true,
    "lat_field": "start_latitude",
    "lon_field": "start_longitude",
    "h3_resolutions": [
      7,
      9,
      11,
      13
    ],
    "morton_z_order": true
  },
  "cross_covariance_matrix": {
    "enabled": true,
    "measure_fields": [
      "duration_minutes",
      "hourly_rate_cents"
    ]
  }
}
