{
  "entity": "technician_shift",
  "engine": "oltp",
  "is_system": false,
  "track_history": true,
  "attributes": [
    {
      "name": "user_id",
      "type": "reference",
      "entityRef": "user",
      "cardinality": "one",
      "required": true,
      "is_dimension": true
    },
    {
      "name": "shift_date",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "required": true,
      "is_dimension": true
    },
    {
      "name": "start_time",
      "type": "epoch",
      "required": true
    },
    {
      "name": "end_time",
      "type": "epoch",
      "required": true
    },
    {
      "name": "status",
      "type": "enum",
      "options": [
        "SCHEDULED",
        "IN_PROGRESS",
        "COMPLETED",
        "MISSED"
      ],
      "default_value": "SCHEDULED",
      "is_dimension": true
    }
  ]
}
