{
  "entity": "audit_log",
  "is_system": false,
  "track_history": false,
  "partition_strategy": "YYYY-MM-DD",
  "disable_eda": true,
  "attributes": [
    {
      "name": "tenant_id",
      "type": "reference",
      "entityRef": "tenant",
      "required": true,
      "is_dimension": true
    },
    {
      "name": "user_id",
      "type": "reference",
      "entityRef": "user",
      "required": true,
      "is_dimension": true
    },
    {
      "name": "action_type",
      "type": "enum",
      "options": [
        "READ",
        "WRITE",
        "DELETE",
        "ACCESS_DENIED",
        "QUOTA_EXHAUSTED",
        "PLUGIN_REJECTED"
      ],
      "required": true,
      "is_dimension": true
    },
    {
      "name": "resource_domain",
      "type": "string",
      "required": true,
      "is_dimension": true,
      "doc": "The entity type being accessed (e.g., 'asset')"
    },
    {
      "name": "resource_id",
      "type": "uuid",
      "doc": "Optional. The specific entity ID being accessed, if applicable."
    },
    {
      "name": "client_ip",
      "type": "string",
      "is_dimension": true
    },
    {
      "name": "security_context",
      "type": "string",
      "doc": "Snapshot of the Cedar evaluation, opaque token claims, and groups — serialized as JSON string."
    },
    {
      "name": "execution_time_ms",
      "type": "long",
      "is_measure": true,
      "doc": "Total execution time for the query or transaction.",
      "math_profile": {
        "synopsis_tier": "hyper_512b",
        "distribution_family": "lognormal",
        "outlier_sigma_threshold": 3.5,
        "ema_alphas": [
          0.05,
          0.2,
          0.5
        ],
        "enable_cusum": true,
        "cusum_slack_k": 0.5,
        "cusum_threshold_h": 4.0,
        "enable_benford_audit": false,
        "enable_weibull_mle": true
      }
    },
    {
      "name": "plugin_telemetry",
      "type": "string",
      "doc": "If plugins were executed in the pipeline, array of execution times and results — serialized as JSON string."
    }
  ]
}
