{
  "entity": "user_group",
  "is_system": false,
  "track_history": true,
  "attributes": [
    {
      "name": "name",
      "type": "string",
      "unique": "tenant",
      "required": true,
      "fts": true,
      "is_dimension": true,
      "fuzzy_profile": {
        "max_edit_distance": 1,
        "enable_symspell": true,
        "enable_trigrams": true,
        "phonetic_algorithm": "none",
        "alphanumeric_code_normalizer": true,
        "bm25_field_boost": 5.0
      }
    },
    {
      "name": "description",
      "type": "string"
    },
    {
      "name": "allowed_locations",
      "type": "reference",
      "entityRef": "location",
      "cardinality": "many",
      "doc": "Contextual Authorization: List of locations this group is authorized to access."
    },
    {
      "name": "allowed_assets",
      "type": "reference",
      "entityRef": "asset",
      "cardinality": "many",
      "doc": "Contextual Authorization: List of specific assets this group is authorized to access."
    },
    {
      "name": "parent_user_group_id",
      "type": "reference",
      "entityRef": "user_group",
      "cardinality": "one",
      "is_dimension": true,
      "doc": "Optional parent user group for hierarchical inheritance of group boundaries."
    },
    {
      "name": "time_restrictions",
      "type": "array",
      "items": {
        "type": "map",
        "keys": {
          "days_of_week": {
            "type": "array",
            "items": {
              "type": "int"
            },
            "description": "1: Monday, 7: Sunday"
          },
          "start_minute": {
            "type": "int",
            "description": "Minutes from 00:00 (e.g., 480 for 08:00)"
          },
          "end_minute": {
            "type": "int",
            "description": "Minutes from 00:00 (e.g., 1080 for 18:00)"
          }
        }
      },
      "doc": "Optional temporal boundaries for group-level authorization."
    }
  ]
}
