{:paths ["src" "resources"]
 :deps {org.clojure/clojure     {:mvn/version "1.12.0"}
        org.clojure/core.async  {:mvn/version "1.6.681"}

        ;; Lifecycle — Integrant
        integrant/integrant {:mvn/version "0.10.0"}

        ;; API Core & Validation
        metosin/malli {:mvn/version "0.16.4"}

        ;; OLTP Datahike Serverless
        io.replikativ/datahike          {:mvn/version "0.6.1597"}
        io.replikativ/datahike-dynamodb {:mvn/version "0.1.9"}

        ;; Cloud & Infrastructure SDKs
        com.cognitect.aws/api       {:mvn/version "0.8.692"}
        com.cognitect.aws/endpoints {:mvn/version "1.1.12.772"}
        com.cognitect.aws/dynamodb  {:mvn/version "848.2.1413.0"}
        com.cognitect.aws/sqs       {:mvn/version "871.2.34.1"}
        com.cognitect.aws/firehose  {:mvn/version "871.2.31.64"}
        com.cognitect.aws/events    {:mvn/version "871.2.32.30"}
        software.amazon.awssdk/athena {:mvn/version "2.25.11"}
        com.github.f4b6a3/ulid-creator {:mvn/version "5.2.3"}
        
        ;; Observability & Telemetry (ADOT)
        com.github.steffan-westcott/clj-otel-api {:mvn/version "0.2.6"}
        com.github.steffan-westcott/clj-otel-sdk {:mvn/version "0.2.6"}
        com.github.steffan-westcott/clj-otel-exporter-otlp {:mvn/version "0.2.6"}

        ;; gRPC Runtime — grpc-netty (no-shaded) evita conflicto con protobuf embebido
        io.grpc/grpc-netty    {:mvn/version "1.73.0"}
        io.grpc/grpc-protobuf {:mvn/version "1.73.0"}
        io.grpc/grpc-stub     {:mvn/version "1.73.0"}
        io.grpc/grpc-services {:mvn/version "1.73.0"} ;; Health + Reflection
        ;; Netty transport (requerido por grpc-netty no-shaded)
        io.netty/netty-codec-http2 {:mvn/version "4.1.119.Final"}
        io.netty/netty-handler     {:mvn/version "4.1.119.Final"}


        ;; Protobuf 4.29.3 — emptyList() public, compatible con Java 25
        com.google.protobuf/protobuf-java      {:mvn/version "4.29.3"}
        com.google.protobuf/protobuf-java-util {:mvn/version "4.29.3"}
        javax.annotation/javax.annotation-api  {:mvn/version "1.3.2"}

        ;; Valkey / Redis
        com.taoensso/carmine {:mvn/version "3.4.0"}

        ;; Logging estructurado
        com.taoensso/timbre {:mvn/version "6.5.0"}

        ;; Observability
        io.opentelemetry/opentelemetry-api {:mvn/version "1.37.0"}

        ;; AWS Lambda
        com.amazonaws/aws-lambda-java-core   {:mvn/version "1.2.3"}
        com.amazonaws/aws-lambda-java-events {:mvn/version "3.11.4"}

        ;; JSON (lambda/handler)
        cheshire/cheshire {:mvn/version "5.13.0"}

        ;; ULID — Universally Unique Lexicographically Sortable Identifier
        ;; Referencia estándar JVM: 0 deps transitivas, monotónico, thread-safe
        }

 :aliases
 {:dev
  {:extra-paths ["test" "dev" "target/classes"]  ;; "dev" incluye codice.repl y target/classes para protoc
   :extra-deps  {integrant/repl {:mvn/version "0.3.3"}}}

  :test
  {:extra-paths ["test"]
   :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts   ["-m" "cognitect.test-runner"
                 ;; Exclude metri.infrastructure-test (requires Docker/LocalStack)
                 ;; Use --namespace-regex to run only unit tests
                 "--namespace-regex"
                 "metri\\.infrastructure\\.[a-z].*|metri\\.iop\\..*|metri\\.domain\\..*|metri\\.lambda\\..*|metri\\.grpc\\..*|metri\\.codice\\..*|metri\\.janus-router\\..*"]}

  ;; ── Tests de gRPC — incluye el JAR compilado con los stubs Protobuf ──────
  ;; Requiere: clojure -T:build uber (o que target/metres-engine.jar exista)
  ;; Ejecutar: clojure -M:test-grpc --namespace-regex 'metri.grpc.*'
  :test-grpc
  {:extra-paths ["test"]
   :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :jvm-opts    ["-cp" "target/metres-engine.jar"]
   :main-opts   ["-m" "cognitect.test-runner"
                 "--namespace-regex" "metri\\.grpc\\..*"]}

  :build
  {:deps       {io.github.clojure/tools.build {:git/tag "v0.10.5" :git/sha "2a21b7a"}}
   :ns-default build}}}
