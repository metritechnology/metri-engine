{
  "entity": "company",
  "engine": "oltp",
  "is_system": false,
  "track_history": true,
  "attributes": [
    {
      "name": "company_type",
      "type": "enum",
      "options": [
        "CLIENT",
        "PROVIDER",
        "MANUFACTURER",
        "CONTRACTOR"
      ],
      "required": true,
      "is_dimension": true,
      "description": "Clasificador universal ERP. Permite almacenar Proveedores, Clientes y Contratistas en una \u00fanica tabla relacional."
    },
    {
      "name": "name",
      "type": "string",
      "required": true,
      "fts": true,
      "is_dimension": true
    },
    {
      "name": "tax_id",
      "type": "string",
      "fts": true,
      "description": "Identificador fiscal (RUT, NIT, VAT, EIN)."
    },
    {
      "name": "contact_email",
      "type": "string",
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    },
    {
      "name": "contact_phone",
      "type": "string"
    },
    {
      "name": "address",
      "type": "string"
    },
    {
      "name": "status",
      "type": "enum",
      "options": [
        "ACTIVE",
        "INACTIVE"
      ],
      "default_value": "ACTIVE",
      "is_dimension": true
    }
  ],
  "events": {
    "create": "COMPANY_CREATED",
    "update": "COMPANY_UPDATED",
    "delete": "COMPANY_DELETED"
  }
}
