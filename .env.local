# ═══════════════════════════════════════════════════════
#  Metri Engine — Variables de entorno LOCAL
#  Uso: export $(cat .env.local | xargs) && cargo run
#  O:   make infra && cargo run
# ═══════════════════════════════════════════════════════

ENVIRONMENT=local
RUST_LOG=info,metri_engine=debug
RUST_BACKTRACE=1

# ── gRPC ─────────────────────────────────────────────
GRPC_PORT=9090
GRPC_REFLECTION_ENABLED=true

# ── AWS (simulated) ──────────────────────────────────
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# ── DynamoDB Local (make infra → puerto 8000) ────────
DYNAMODB_ENDPOINT=http://localhost:8000
EAV_TABLE=metri-eav-local
FTS_TABLE=metri-fts-local
SCHEMAS_TABLE=metri-schemas-local
QUOTA_TABLE=metri-quota-local
CEDAR_TABLE=metri-cedar-local

# ── S3 / MinIO (make infra → puerto 9000) ────────────
S3_ENDPOINT=http://localhost:9000
S3_LAKE_BUCKET=metri-lake-local
S3_RESULTS_BUCKET=metri-athena-results-local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ── SQS / ElasticMQ (make infra → puerto 9324) ───────
SQS_ENDPOINT=http://localhost:9324
OUTBOX_QUEUE_URL=http://localhost:9324/000000000000/metri-outbox.fifo
DLQ_QUEUE_URL=http://localhost:9324/000000000000/metri-outbox-dlq.fifo


# ── Códice ────────────────────────────────────────────
CODICE_MODELS_DIR=config/models
ERROR_CATALOG_PATH=config/errors/error_catalog.toml

# ── HMAC Auth (secret local estático) ────────────────
# NUNCA usar este valor en producción
HMAC_SECRET=local-dev-secret-do-not-use-in-prod

# ── OLAP Athena (stub en local) ───────────────────────
ATHENA_MODE=stub
ATHENA_WORKGROUP=primary
