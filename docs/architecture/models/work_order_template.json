{
  "entity": "work_order_template",
  "engine": "oltp",
  "is_system": false,
  "track_history": true,
  "attributes": [
    {
      "name": "id",
      "type": "uuid",
      "is_system": false
    },
    {
      "name": "title",
      "type": "string",
      "required": true,
      "fts": true
    },
    {
      "name": "description",
      "type": "string"
    },
    {
      "name": "assigned_role_id",
      "type": "reference",
      "entityRef": "role",
      "cardinality": "one"
    },
    {
      "name": "assigned_group_id",
      "type": "reference",
      "entityRef": "user_group",
      "cardinality": "one"
    },
    {
      "name": "estimated_duration_minutes",
      "type": "integer",
      "description": "Tiempo teórico de ejecución de la plantilla (Ej. 120 = 2 horas)."
    },
    {
      "name": "notification_template_code",
      "type": "string",
      "required": false,
      "description": "El Código exacto (Ej: 'PM_NIVEL_1_CRITICO') que AWS usará para renderizar el texto físico de Twilio o Push Firebase cuando despierte en el futuro."
    },
    {
      "name": "status",
      "type": "enum",
      "options": [
        "ACTIVE",
        "DRAFT",
        "RETIRED"
      ],
      "default_value": "ACTIVE",
      "is_dimension": true
    }
  ],
  "events": {
    "create": "WORK_ORDER_TEMPLATE_CREATED",
    "update": "WORK_ORDER_TEMPLATE_UPDATED",
    "delete": "WORK_ORDER_TEMPLATE_DELETED"
  }
}
