{
  "entity": "downtime_log",
  "engine": "oltp",
  "is_system": false,
  "track_history": true,
  "partition_strategy": "YYYY-MM",
  "attributes": [
    {
      "name": "id",
      "type": "uuid",
      "is_system": false
    },
    {
      "name": "asset_id",
      "type": "reference",
      "entityRef": "asset",
      "cardinality": "one",
      "required": true,
      "is_dimension": true
    },
    {
      "name": "work_order_id",
      "type": "reference",
      "entityRef": "work_order",
      "cardinality": "one",
      "description": "Optional link to the WO that resolved the downtime"
    },
    {
      "name": "start_time",
      "type": "epoch",
      "required": true,
      "index": true
    },
    {
      "name": "end_time",
      "type": "epoch",
      "index": true
    },
    {
      "name": "duration_minutes",
      "type": "decimal",
      "is_measure": true,
      "default_rollup": "sum"
    },
    {
      "name": "reason",
      "type": "string",
      "fts": true,
      "is_dimension": true
    }
  ]
}
