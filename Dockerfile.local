# ══════════════════════════════════════════════════════════════════════════════
#  Dockerfile.local — Build multi-stage para desarrollo local
#  Genera el binario nativo Rust en modo debug (rápido) o release (prod-like).
#
#  Targets:
#    builder  → imagen completa con Rust toolchain + cargo-watch (dev)
#    runtime  → imagen mínima con solo el binario compilado (engine profile)
#
#  Uso:
#    docker compose build engine          ← compila release
#    docker compose --profile dev up      ← hot-reload con cargo-watch
# ══════════════════════════════════════════════════════════════════════════════

# ── Stage 1: Builder ──────────────────────────────────────────────────────────
FROM rust:1.94-slim AS builder

# Dependencias del sistema necesarias para las crates con código C
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    protobuf-compiler \
    cmake \
    curl \
    # cargo-watch para hot-reload en dev (fijamos versión por compatibilidad con Rust 1.78)
    && cargo install cargo-watch --version 8.4.1 --locked \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── Capa de dependencias (cache-friendly) ─────────────────────────────────────
# Copiamos solo los archivos de manifiesto primero para que Docker cachee
# las dependencias y no las recompile en cada cambio de fuente.
COPY Cargo.toml Cargo.lock build.rs ./

# Directorio src mínimo para que cargo descargue deps sin compilar el fuente real
RUN mkdir -p src && echo 'fn main() {}' > src/main.rs
RUN cargo build --release 2>/dev/null || true
RUN rm -rf src/

# ── Compilación completa ───────────────────────────────────────────────────────
COPY src/    ./src/
COPY proto/  ./proto/
COPY config/ ./config/

RUN cargo build --release \
    && mv target/release/bootstrap /usr/local/bin/metri-engine

# ── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    curl \
    # grpcurl para el healthcheck
    && curl -sSL https://github.com/fullstorydev/grpcurl/releases/download/v1.9.1/grpcurl_1.9.1_linux_amd64.tar.gz \
       | tar xz -C /usr/local/bin grpcurl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copiar binario compilado
COPY --from=builder /usr/local/bin/metri-engine /usr/local/bin/metri-engine

# config/ se monta como volumen en docker-compose (overrideable en prod via env)
# Se copia aquí como fallback si no hay volumen montado
COPY --from=builder /app/config/ ./config/

EXPOSE 9090

HEALTHCHECK --interval=15s --timeout=10s --start-period=20s --retries=3 \
    CMD grpcurl -plaintext localhost:9090 grpc.health.v1.Health/Check || exit 1

ENTRYPOINT ["/usr/local/bin/metri-engine"]
